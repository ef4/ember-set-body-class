{
  "name": "ember-set-body-class",
  "type": "module",
  "version": "1.0.2",
  "description": "Fastboot-compatible, template-driven helper for setting <body> classes.",
  "keywords": [
    "ember-addon",
    "body",
    "class",
    "fastboot"
  ],
  "license": "MIT",
  "author": "Edward Faulkner <edward@eaf4.com>",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "repository": "https://github.com/ef4/ember-set-body-class",
  "dependencies": {
    "@embroider/addon-shim": "^1.10.0"
  },
  "engines": {
    "node": ">=16"
  },
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*",
    "./addon-main.js": "./addon-main.js"
  },
  "files": [
    "addon-main.js",
    "dist"
  ],
  "scripts": {
    "build": "rollup --config",
    "prepublishOnly": "rollup --config",
    "start": "rollup --config --watch"
  },
  "ember-addon": {
    "main": "addon-main.js",
    "type": "addon",
    "version": 2,
    "app-js": {
      "./helpers/set-body-class.js": "./dist/_app_/helpers/set-body-class.js",
      "./services/body-class.js": "./dist/_app_/services/body-class.js"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@embroider/addon-dev": "^8.1.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/ember": "^4.0.11",
    "@types/ember__application": "^4.0.11",
    "@types/ember__array": "^4.0.10",
    "@types/ember__component": "^4.0.22",
    "@types/ember__object": "^4.0.12",
    "@types/ember__runloop": "^4.0.10",
    "@types/ember__service": "^4.0.9",
    "rollup": "^4.46.2",
    "typescript": "^5.9.2"
  }
}
